# Chave da API da Anthropic. NUNCA use o prefixo VITE_ aqui:
# variáveis VITE_ vão parar dentro do pacote que o navegador baixa.
# Esta chave é lida somente no servidor, dentro de /api/chat.ts.
ANTHROPIC_API_KEY=sk-ant-...

# Opcionais (têm padrão, só mexa se precisar):
# TUTOR_MODELO=claude-sonnet-5
# TUTOR_LIMITE_MENSAGENS_HORA=30
# ANTHROPIC_BASE_URL=https://api.anthropic.com
