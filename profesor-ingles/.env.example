# Llave del proveedor del modelo. SOLO en el servidor.
# Nunca uses el prefijo VITE_ para esta variable: eso la metería en el bundle
# del navegador y quedaría visible para cualquiera.
ANTHROPIC_API_KEY=sk-ant-...

# Opcionales
# Modelo a usar (por defecto: claude-sonnet-5)
# LLM_MODEL=claude-sonnet-5
# Mensajes permitidos por sesión dentro de la ventana (por defecto: 30)
# RATE_LIMIT_MAX=30
# Tamaño de la ventana en milisegundos (por defecto: 3600000 = 1 hora)
# RATE_LIMIT_WINDOW_MS=3600000
